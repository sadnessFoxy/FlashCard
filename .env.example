# FlashCard Backend Environment Variables
# Copy to backend/.env and fill in real values
# Never commit .env

# --- Database ---
DATABASE_URL=postgresql+asyncpg://flashcard:flashcard@localhost:5432/flashcard

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Security ---
# Generate: openssl rand -hex 32
SECRET_KEY=change-me-run-openssl-rand-hex-32-and-paste-here

# --- AI / Gemini ---
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# --- Object Storage (MinIO local dev) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=flashcard
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Email (Mailpit local dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# --- Business Rules ---
MAX_FILE_SIZE_MB=20
MAX_PAGES=200
MAX_DOCUMENTS_PER_USER=10
USER_DAILY_QUERY_LIMIT=30
